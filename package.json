{
  "name": "portfolio-kpulka",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "react-router dev --host",
    "stats": "node scripts/fetch-stats.mjs",
    "build": "node scripts/fetch-stats.mjs && react-router typegen && tsc -b && react-router build",
    "postbuild": "node scripts/copy-404.js && node scripts/write-sitemap.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --outDir dist/client",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/anybody": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@react-router/node": "7.9.3",
    "@tailwindcss/vite": "^4.1.13",
    "isbot": "^5.2.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-router": "7.9.3",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.65.1",
    "@react-router/dev": "7.9.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.181.0",
    "baseline-browser-mapping": "^2.8.31",
    "conventional-changelog": "^7.1.1",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "prettier": "^3.8.3",
    "semantic-release": "^24.2.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.6",
    "vitest": "^5.1.0"
  }
